# PostgreSQL
POSTGRES_DB=rpa
POSTGRES_USER=rpa
POSTGRES_PASSWORD=rpa_local
DATABASE_URL=postgresql://rpa:rpa_local@postgres:5432/rpa?schema=public

# RabbitMQ
RABBITMQ_DEFAULT_USER=rpa
RABBITMQ_DEFAULT_PASS=rpa_local
RABBITMQ_URL=amqp://rpa:rpa_local@rabbitmq:5672/

# API / Frontend
API_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker
TARGET_URL=https://example.com
HEADLESS=true
TIMEOUT_MS=30000
OUTPUT_DIR=/app/downloads
ARTIFACTS_DIR=/artifacts
WORKER_ID=rpa-worker-1
WORKER_CONCURRENCY=2
MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=120
