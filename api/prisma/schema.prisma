generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExecutionStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Execution {
  id             String             @id @default(uuid())
  idempotencyKey String             @unique
  url            String
  status         ExecutionStatus    @default(QUEUED)
  progress       Int                @default(0)
  attemptCount   Int                @default(0)
  workerId       String?
  result         Json?
  error          String?
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  events         ExecutionEvent[]
  attempts       ExecutionAttempt[]
  artifacts      ExecutionArtifact[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ExecutionEvent {
  id          String          @id
  executionId String
  type        String
  message     String
  status      ExecutionStatus?
  progress    Int?
  metadata    Json?
  createdAt   DateTime        @default(now())
  execution   Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model ExecutionAttempt {
  id          String          @id @default(uuid())
  executionId String
  number      Int
  status      ExecutionStatus
  workerId    String?
  error       String?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  execution   Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, number])
}

model ExecutionArtifact {
  id          String    @id @default(uuid())
  executionId String
  name        String
  key         String
  mimeType    String
  size        Int
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, key])
}

model OutboxMessage {
  id          String       @id @default(uuid())
  aggregateId String
  routingKey  String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
}
